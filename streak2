class Solution(object):
    def partitionArray(self, nums, k):
        """
        :type nums: List[int]
        :type k: int
        :rtype: int
        """
        nums.sort()
        count = 0
        i = 0
        n = len(nums)
        
        while i < n:
            count += 1
            min_val = nums[i]
            # Keep adding to the current group as long as max - min <= k
            while i < n and nums[i] - min_val <= k:
                i += 1
        
        return count
